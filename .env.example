# Copy this file to ".env" (same folder as run.py) and edit the values.
# NEVER commit your real .env file.

# Secret used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# (If left empty, a random key is generated once for local development.)
SECRET_KEY=

# Admin account created the FIRST time the database is initialised.
# If ADMIN_PASSWORD is empty a random password is generated and printed once.
ADMIN_NAME=Canteen Admin
ADMIN_EMAIL=admin@smartcanteen.local
ADMIN_PASSWORD=ChangeMe@123

# Server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

# Set to true when the site is served over HTTPS
SESSION_COOKIE_SECURE=false

# Optional: extra allowed frontend origins (comma separated)
# CORS_ORIGINS=http://localhost:5500

# Business settings
TAX_RATE=0.05
CANTEEN_CHEFS=6

# Optional: custom database / upload locations
# DATABASE_PATH=
# UPLOAD_FOLDER=
